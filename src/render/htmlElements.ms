		readonly readyState: number;
		src: string;
		srclang: string;
	}

	export extern class HTMLUListElement extends HTMLElement {
		compact: boolean;
		type: string;
	}

	export extern class HTMLVideoElement extends HTMLMediaElement {
		disablePictureInPicture: boolean;
		height: number;
		playsInline: boolean;
		poster: string;
		readonly videoHeight: number;
		readonly videoWidth: number;
		width: number;
	}

	/** The DOM element class each HTML tag creates, as TypeScript's `HTMLElementTagNameMap`. */
	export interface HTMLElementTagNameMap {
