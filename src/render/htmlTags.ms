/** Attributes of `<script>` beyond the global ones. */
export interface HtmlScriptAttributes {
	/**
	 * Runs the script as soon as it is fetched, without waiting for parsing.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#async)
	 */
	async: boolean;
	/**
	 * Rendering waits until this resource is loaded.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#blocking)
	 */
	blocking: "render";
	/**
	 * Whether the request is made with CORS, and with which credentials.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#crossorigin)
	 */
	crossorigin: "anonymous" | "use-credentials" | "";
	/**
	 * Runs the script after the document has been parsed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#defer)
	 */
	defer: boolean;
	/**
	 * The priority of the fetch relative to others.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#fetchpriority)
	 */
	fetchpriority: "high" | "low" | "auto";
	/**
	 * A hash the fetched resource must match.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#integrity)
	 */
	integrity: string;
	/**
	 * Skips the script in browsers that support module scripts.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#nomodule)
	 */
	nomodule: boolean;
	/**
	 * How much referrer information is sent with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#referrerpolicy)
	 */
	referrerpolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#src)
	 */
	src: string;
	/**
	 * The kind of script: a module, a classic script or data. Common values: `importmap`, `module`,
	 * `speculationrules`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#type)
	 */
	type: string;
	/**
	 * Registers an attribution source or trigger with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#attributionsrc)
	 */
	attributionsrc: string;
	/**
	 * Same as `crossorigin`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#crossorigin)
	 */
	crossOrigin: "anonymous" | "use-credentials" | "";
	/**
	 * Same as `nomodule`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#nomodule)
	 */
	noModule: boolean;
	/**
	 * Same as `referrerpolicy`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#referrerpolicy)
	 */
	referrerPolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Deprecated. The character encoding of the document or resource.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#charset)
	 */
	charset: string;
	/**
	 * Deprecated. The event that triggers the script.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#event)
	 */
	event: string;
	/**
	 * Deprecated. The scripting language of the script.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script#language)
	 */
	language: string;
}

