		"subtitles" |
		"captions" |
		"chapters" |
		"metadata";
	/**
	 * The title of the track shown to the user.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track#label)
	 */
	label: string;
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track#src)
	 */
	src: string;
	/**
	 * The language of the text track.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track#srclang)
	 */
	srclang: string;
	/**
	 * Same as `mediagroup`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track#mediagroup)
	 */
	mediaGroup: string;
	/**
	 * Deprecated. Groups media elements so they play in sync.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track#mediagroup)
	 */
	mediagroup: string;
}

/** Attributes of `<video>` beyond the global ones. */
export interface HtmlVideoAttributes {
	/**
	 * Stops the browser from offering picture-in-picture.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#disablepictureinpicture)
	 */
	disablepictureinpicture: boolean;
	/**
	 * The height, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#height)
	 */
	height: number | string;
	/**
	 * Plays the video inline instead of full screen on mobile.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#playsinline)
	 */
	playsinline: boolean;
	/**
	 * An image shown before the video plays.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#poster)
	 */
	poster: string;
	/**
	 * The width, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#width)
	 */
	width: number | string;
	/**
	 * Starts playback as soon as the media can play.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#autoplay)
	 */
	autoplay: boolean;
	/**
	 * Shows the browser's playback controls.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#controls)
	 */
	controls: boolean;
	/**
	 * Which browser playback controls are hidden. Common values: `nodownload`, `nofullscreen`,
	 * `noplaybackrate`, `noremoteplayback`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#controlslist)
	 */
	controlslist: string;
	/**
	 * Whether the request is made with CORS, and with which credentials.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#crossorigin)
	 */
	crossorigin: "anonymous" | "use-credentials" | "";
	/**
	 * Stops the browser from offering remote playback.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#disableremoteplayback)
	 */
	disableremoteplayback: boolean;
	/**
	 * Starts again from the beginning when playback ends.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#loop)
	 */
	loop: boolean;
	/**
	 * Starts with the sound muted.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#muted)
	 */
	muted: boolean;
	/**
	 * How much of the media to load before playback.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#preload)
	 */
	preload: "none" | "metadata" | "auto" | "";
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#src)
	 */
	src: string;
	/**
	 * Same as `crossorigin`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#crossorigin)
	 */
	crossOrigin: "anonymous" | "use-credentials" | "";
	/**
	 * Same as `mediagroup`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#mediagroup)
	 */
	mediaGroup: string;
	/**
	 * Deprecated. Groups media elements so they play in sync.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video#mediagroup)
	 */
	mediagroup: string;
}

/**
 * The HTML elements a lowercase JSX tag may name, each with its attributes beyond
 * `HtmlGlobalAttributes`.
 */
export interface HtmlElements {
	/**
	 * `<a>`: A hyperlink to another page, a place in this page, or any URL.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a)
	 */
	a: HtmlAnchorAttributes;
	/**
	 * `<abbr>`: An abbreviation or acronym; its title can spell it out.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/abbr)
	 */
	abbr: HtmlGlobalAttributes;
	/**
	 * `<address>`: Contact information for the nearest article or the page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/address)
	 */
	address: HtmlGlobalAttributes;
	/**
	 * `<area>`: A clickable region inside an image map.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/area)
	 */
	area: HtmlAreaAttributes;
	/**
	 * `<article>`: A self-contained piece of content, such as a post or a card.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/article)
	 */
	article: HtmlGlobalAttributes;
	/**
	 * `<aside>`: Content related to the main content only indirectly, such as a sidebar.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/aside)
	 */
	aside: HtmlGlobalAttributes;
	/**
	 * `<audio>`: Plays sound from one or more sources.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/audio)
	 */
	audio: HtmlAudioAttributes;
	/**
	 * `<b>`: Text set apart without extra importance, drawn bold by default.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/b)
	 */
	b: HtmlGlobalAttributes;
	/**
	 * `<base>`: Sets the base URL and default target for every relative URL in the page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base)
	 */
	base: HtmlBaseAttributes;
	/**
	 * `<bdi>`: Text isolated from the surrounding text direction.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/bdi)
	 */
	bdi: HtmlGlobalAttributes;
	/**
	 * `<bdo>`: Text whose direction is forced, overriding the bidirectional algorithm.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/bdo)
	 */
	bdo: HtmlBdoAttributes;
	/**
	 * `<blockquote>`: A quotation set apart as its own block.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/blockquote)
	 */
	blockquote: HtmlBlockquoteAttributes;
	/**
	 * `<body>`: The content of the document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/body)
	 */
	body: HtmlBodyAttributes;
	/**
	 * `<br>`: A line break inside text.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/br)
	 */
	br: HtmlGlobalAttributes;
	/**
	 * `<button>`: A clickable control that submits a form or runs an action.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button)
	 */
	button: HtmlButtonAttributes;
	/**
	 * `<canvas>`: A bitmap surface drawn by script through a 2D or WebGL context.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/canvas)
	 */
	canvas: HtmlCanvasAttributes;
	/**
	 * `<caption>`: The title of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/caption)
	 */
	caption: HtmlCaptionAttributes;
	/**
	 * `<cite>`: The title of a creative work being referenced.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/cite)
	 */
	cite: HtmlGlobalAttributes;
	/**
	 * `<code>`: A fragment of computer code.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/code)
	 */
	code: HtmlGlobalAttributes;
	/**
	 * `<col>`: One column of a table, for styling it as a whole.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/col)
	 */
	col: HtmlColAttributes;
	/**
	 * `<colgroup>`: A group of table columns.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/colgroup)
	 */
	colgroup: HtmlColgroupAttributes;
	/**
	 * `<data>`: Content paired with a machine-readable value.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/data)
	 */
	data: HtmlDataAttributes;
	/**
	 * `<datalist>`: A list of suggested options for an input.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/datalist)
	 */
	datalist: HtmlGlobalAttributes;
	/**
	 * `<dd>`: The description of the preceding term in a description list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/dd)
	 */
	dd: HtmlGlobalAttributes;
	/**
	 * `<del>`: Text that was removed from the document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/del)
	 */
	del: HtmlModAttributes;
	/**
	 * `<details>`: A disclosure widget that shows its content when opened.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/details)
	 */
	details: HtmlDetailsHtmlAttributesAttributes;
	/**
	 * `<dfn>`: The term being defined in the surrounding text.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/dfn)
	 */
	dfn: HtmlGlobalAttributes;
	/**
	 * `<dialog>`: A dialog box or modal window.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/dialog)
	 */
	dialog: HtmlDialogHtmlAttributesAttributes;
	/**
	 * `<div>`: A generic block container with no meaning of its own.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div)
	 */
	div: HtmlGlobalAttributes;
	/**
	 * `<dl>`: A description list of terms and their descriptions.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/dl)
	 */
	dl: HtmlGlobalAttributes;
	/**
	 * `<dt>`: A term in a description list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/dt)
	 */
	dt: HtmlGlobalAttributes;
	/**
	 * `<em>`: Text with stress emphasis.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/em)
	 */
	em: HtmlGlobalAttributes;
	/**
	 * `<embed>`: Content from an external application or plugin.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/embed)
	 */
	embed: HtmlEmbedAttributes;
	/**
	 * `<fieldset>`: A group of form controls, usually with a legend.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/fieldset)
	 */
	fieldset: HtmlFieldsetAttributes;
	/**
	 * `<figcaption>`: The caption of its parent figure.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/figcaption)
	 */
	figcaption: HtmlGlobalAttributes;
	/**
	 * `<figure>`: Self-contained content such as an image or listing, with an optional caption.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/figure)
	 */
	figure: HtmlGlobalAttributes;
	/**
	 * `<footer>`: The footer of its nearest section or of the page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/footer)
	 */
	footer: HtmlGlobalAttributes;
	/**
	 * `<form>`: A section of controls whose values are submitted together.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form)
	 */
	form: HtmlFormAttributes;
	/**
	 * `<h1>`: A top-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h1)
	 */
	h1: HtmlGlobalAttributes;
	/**
	 * `<h2>`: A second-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h2)
	 */
	h2: HtmlGlobalAttributes;
	/**
	 * `<h3>`: A third-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h3)
	 */
	h3: HtmlGlobalAttributes;
	/**
	 * `<h4>`: A fourth-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h4)
	 */
	h4: HtmlGlobalAttributes;
	/**
	 * `<h5>`: A fifth-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h5)
	 */
	h5: HtmlGlobalAttributes;
	/**
	 * `<h6>`: A sixth-level section heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h6)
	 */
	h6: HtmlGlobalAttributes;
	/**
	 * `<head>`: Metadata about the document: title, styles, scripts and meta tags.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/head)
	 */
	head: HtmlGlobalAttributes;
	/**
	 * `<header>`: Introductory content or navigation for a section or the page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/header)
	 */
	header: HtmlGlobalAttributes;
	/**
	 * `<hgroup>`: A heading grouped with its subtitles.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/hgroup)
	 */
	hgroup: HtmlGlobalAttributes;
	/**
	 * `<hr>`: A thematic break between paragraphs.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/hr)
	 */
	hr: HtmlGlobalAttributes;
	/**
	 * `<html>`: The root element of an HTML document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/html)
	 */
	html: HtmlGlobalAttributes;
	/**
	 * `<i>`: Text in an alternate voice, such as a technical term, drawn italic by default.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/i)
	 */
	i: HtmlGlobalAttributes;
	/**
	 * `<iframe>`: Another page embedded in this one.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe)
	 */
	iframe: HtmlIframeAttributes;
	/** `<img>`: An image. [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img) */
	img: HtmlImgAttributes;
	/**
	 * `<input>`: A form control whose kind is chosen by its type.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input)
	 */
	input: HtmlInputAttributes;
	/**
	 * `<ins>`: Text that was added to the document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/ins)
	 */
	ins: HtmlModAttributes;
	/**
	 * `<kbd>`: Text the user types on a keyboard.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/kbd)
	 */
	kbd: HtmlGlobalAttributes;
	/**
	 * `<label>`: A caption for a form control; clicking it focuses the control.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/label)
	 */
	label: HtmlLabelAttributes;
	/**
	 * `<legend>`: The caption of its parent fieldset.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/legend)
	 */
	legend: HtmlGlobalAttributes;
	/**
	 * `<li>`: An item in a list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/li)
	 */
	li: HtmlLiAttributes;
	/**
	 * `<link>`: A relation to an external resource, most often a stylesheet or an icon.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link)
	 */
	link: HtmlLinkAttributes;
	/**
	 * `<main>`: The dominant content of the page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/main)
	 */
	main: HtmlGlobalAttributes;
	/**
	 * `<map>`: An image map, together with its areas.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/map)
	 */
	map: HtmlMapAttributes;
	/**
	 * `<mark>`: Text highlighted for reference.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/mark)
	 */
	mark: HtmlGlobalAttributes;
	/**
	 * `<menu>`: A list of commands, treated like an unordered list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/menu)
	 */
	menu: HtmlMenuAttributes;
	/**
	 * `<meta>`: Metadata that other head elements cannot express.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/meta)
	 */
	meta: HtmlMetaAttributes;
	/**
	 * `<meter>`: A scalar value within a known range.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/meter)
	 */
	meter: HtmlMeterAttributes;
	/**
	 * `<nav>`: A section of navigation links.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/nav)
	 */
	nav: HtmlGlobalAttributes;
	/**
	 * `<noscript>`: Content shown only when scripting is unavailable.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/noscript)
	 */
	noscript: HtmlGlobalAttributes;
	/**
	 * `<object>`: An external resource such as a PDF or a nested browsing context.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/object)
	 */
	object: HtmlObjectAttributes;
	/**
	 * `<ol>`: An ordered list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/ol)
	 */
	ol: HtmlOlAttributes;
	/**
	 * `<optgroup>`: A group of options inside a select.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/optgroup)
	 */
	optgroup: HtmlOptgroupAttributes;
	/**
	 * `<option>`: An item in a select, an optgroup or a datalist.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/option)
	 */
	option: HtmlOptionAttributes;
	/**
	 * `<output>`: The result of a calculation or user action.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/output)
	 */
	output: HtmlOutputAttributes;
	/** `<p>`: A paragraph. [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/p) */
	p: HtmlGlobalAttributes;
	/**
	 * `<picture>`: Several image sources, of which the browser picks one.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/picture)
	 */
	picture: HtmlGlobalAttributes;
	/**
	 * `<pre>`: Preformatted text, shown exactly as written.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/pre)
	 */
	pre: HtmlGlobalAttributes;
	/**
	 * `<progress>`: The progress of a task.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/progress)
	 */
	progress: HtmlProgressAttributes;
	/**
	 * `<q>`: A short inline quotation.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/q)
	 */
	q: HtmlQuoteAttributes;
	/**
	 * `<rp>`: Fallback parentheses for browsers without ruby support.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/rp)
	 */
	rp: HtmlGlobalAttributes;
	/**
	 * `<rt>`: The pronunciation text of a ruby annotation.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/rt)
	 */
	rt: HtmlGlobalAttributes;
	/**
	 * `<ruby>`: A ruby annotation, small text drawn above or beside base text.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/ruby)
	 */
	ruby: HtmlGlobalAttributes;
	/**
	 * `<s>`: Text that is no longer accurate, drawn struck through.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/s)
	 */
	s: HtmlGlobalAttributes;
	/**
	 * `<samp>`: Sample output from a program.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/samp)
	 */
	samp: HtmlGlobalAttributes;
	/**
	 * `<script>`: An embedded or external script.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/script)
	 */
	script: HtmlScriptAttributes;
	/**
	 * `<search>`: A section holding search or filter controls.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/search)
	 */
	search: HtmlGlobalAttributes;
	/**
	 * `<section>`: A generic standalone section, usually with a heading.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/section)
	 */
	section: HtmlGlobalAttributes;
	/**
	 * `<select>`: A control that picks from a list of options.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/select)
	 */
	select: HtmlSelectAttributes;
	/**
	 * `<slot>`: A placeholder inside a web component that you fill with your own markup.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/slot)
	 */
	slot: HtmlHTMLSlotElementAttributesAttributes;
	/**
	 * `<small>`: Side comments and small print.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/small)
	 */
	small: HtmlGlobalAttributes;
	/**
	 * `<source>`: One media or image source for a picture, audio or video.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/source)
	 */
	source: HtmlSourceAttributes;
	/**
	 * `<span>`: A generic inline container with no meaning of its own.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/span)
	 */
	span: HtmlGlobalAttributes;
	/**
	 * `<strong>`: Text of strong importance, drawn bold by default.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/strong)
	 */
	strong: HtmlGlobalAttributes;
	/**
	 * `<style>`: Style information for the document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/style)
	 */
	style: HtmlStyleAttributes;
	/**
	 * `<sub>`: Subscript text.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/sub)
	 */
	sub: HtmlGlobalAttributes;
	/**
	 * `<summary>`: The visible label of a details element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/summary)
	 */
	summary: HtmlGlobalAttributes;
	/**
	 * `<sup>`: Superscript text.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/sup)
	 */
	sup: HtmlGlobalAttributes;
	/**
	 * `<table>`: Tabular data in rows and columns.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/table)
	 */
	table: HtmlGlobalAttributes;
	/**
	 * `<tbody>`: The body rows of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/tbody)
	 */
	tbody: HtmlGlobalAttributes;
	/**
	 * `<td>`: A data cell of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/td)
	 */
	td: HtmlTdAttributes;
	/**
	 * `<template>`: Markup that is parsed but not rendered, for cloning by script.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/template)
	 */
	template: HtmlTemplateAttributes;
	/**
	 * `<textarea>`: A multi-line plain-text editing control.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/textarea)
	 */
	textarea: HtmlTextareaAttributes;
	/**
	 * `<tfoot>`: The summary rows at the end of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/tfoot)
	 */
	tfoot: HtmlGlobalAttributes;
	/**
	 * `<th>`: A header cell of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/th)
	 */
	th: HtmlThAttributes;
	/**
	 * `<thead>`: The header rows of a table.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/thead)
	 */
	thead: HtmlGlobalAttributes;
	/**
	 * `<time>`: A specific time, date or duration.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/time)
	 */
	time: HtmlTimeAttributes;
	/**
	 * `<title>`: The document title shown in the browser tab.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/title)
	 */
	title: HtmlGlobalAttributes;
	/**
	 * `<tr>`: A row of table cells.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/tr)
	 */
	tr: HtmlGlobalAttributes;
	/**
	 * `<track>`: Timed text such as subtitles for audio or video.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/track)
	 */
	track: HtmlTrackAttributes;
	/**
	 * `<u>`: Text with a non-textual annotation, drawn underlined by default.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/u)
	 */
	u: HtmlGlobalAttributes;
	/**
	 * `<ul>`: An unordered list.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/ul)
	 */
	ul: HtmlGlobalAttributes;
	/**
	 * `<var>`: The name of a variable in math or code.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/var)
	 */
	var: HtmlGlobalAttributes;
	/**
	 * `<video>`: Plays video from one or more sources.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video)
	 */
	video: HtmlVideoAttributes;
	/**
	 * `<wbr>`: A position where the browser may break a line.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/wbr)
	 */
	wbr: HtmlGlobalAttributes;
}

