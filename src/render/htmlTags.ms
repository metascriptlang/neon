	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#type)
	 */
	type: "submit" | "reset" | "button" | "menu";
	/**
	 * The value of the element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#value)
	 */
	value: string;
	/**
	 * The action run on the element named by commandfor. Common values: `show-modal`, `close`,
	 * `show-popover`, `hide-popover`, `toggle-popover`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#command)
	 */
	command: string;
	/**
	 * The id of the element this button controls.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#commandfor)
	 */
	commandfor: string;
	/**
	 * Same as `formaction`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#formaction)
	 */
	formAction: string;
	/**
	 * Same as `formenctype`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#formenctype)
	 */
	formEnctype: "application/x-www-form-urlencoded" | "multipart/form-data" | "text/plain";
	/**
	 * Same as `formmethod`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#formmethod)
	 */
	formMethod: "post" | "get" | "dialog";
	/**
	 * Same as `formnovalidate`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#formnovalidate)
	 */
	formNoValidate: boolean;
	/**
	 * Same as `formtarget`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#formtarget)
	 */
	formTarget: string;
	/**
	 * Same as `popovertarget`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#popovertarget)
	 */
	popoverTarget: string;
	/**
	 * Same as `popovertargetaction`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/button#popovertargetaction)
	 */
	popoverTargetAction: "hide" | "show" | "toggle";
}

