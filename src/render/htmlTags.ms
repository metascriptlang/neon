/** Attributes of `<link>` beyond the global ones. */
export interface HtmlLinkAttributes {
	/**
	 * The kind of resource a preload link fetches.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#as)
	 */
	as:
		"audio" |
		"document" |
		"embed" |
		"fetch" |
		"font" |
		"image" |
		"object" |
		"script" |
		"style" |
		"track" |
		"video" |
		"worker";
	/**
	 * Rendering waits until this resource is loaded.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#blocking)
	 */
	blocking: "render";
	/**
	 * The color of the element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#color)
	 */
	color: string;
	/**
	 * Whether the request is made with CORS, and with which credentials.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#crossorigin)
	 */
	crossorigin: "anonymous" | "use-credentials" | "";
	/**
	 * Disables the control: it cannot be focused, edited or submitted.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#disabled)
	 */
	disabled: boolean;
	/**
	 * The priority of the fetch relative to others.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#fetchpriority)
	 */
	fetchpriority: "high" | "low" | "auto";
	/**
	 * The URL the element points to.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#href)
	 */
	href: string;
	/**
	 * The language of the linked resource.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#hreflang)
	 */
	hreflang: string;
	/**
	 * The sizes used with imagesrcset for a preloaded image.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#imagesizes)
	 */
	imagesizes: string;
	/**
	 * The candidate sources for a preloaded image.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#imagesrcset)
	 */
	imagesrcset: string;
	/**
	 * A hash the fetched resource must match.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#integrity)
	 */
	integrity: string;
	/**
	 * The media query this resource applies to.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#media)
	 */
	media: string;
	/**
	 * How much referrer information is sent with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#referrerpolicy)
	 */
	referrerpolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * The relation of the linked resource to this document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#rel)
	 */
	rel: string;
	/**
	 * Image sizes for different page layouts.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#sizes)
	 */
	sizes: string;
	/**
	 * The media type of the linked resource.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#type)
	 */
	type: string;
	/**
	 * Same as `crossorigin`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#crossorigin)
	 */
	crossOrigin: "anonymous" | "use-credentials" | "";
	/**
	 * Same as `referrerpolicy`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#referrerpolicy)
	 */
	referrerPolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Deprecated. The character encoding of the document or resource.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#charset)
	 */
	charset: string;
	/**
	 * Deprecated. The reverse relation of the link.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#rev)
	 */
	rev: string;
	/**
	 * Deprecated. Where the response or linked page is shown.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/link#target)
	 */
	target: string;
}

