}

/** Attributes of `<form>` beyond the global ones. */
export interface HtmlFormAttributes {
	/**
	 * The URL the form submits to.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#action)
	 */
	action: string;
	/**
	 * Which value the browser may fill in automatically.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#autocomplete)
	 */
	autocomplete: "on" | "off";
	/**
	 * The character encoding of the content.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#encoding)
	 */
	encoding: "application/x-www-form-urlencoded" | "multipart/form-data" | "text/plain";
	/**
	 * The encoding of the submitted form data.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#enctype)
	 */
	enctype: "application/x-www-form-urlencoded" | "multipart/form-data" | "text/plain";
	/**
	 * The HTTP method the form submits with.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#method)
	 */
	method: "post" | "get" | "dialog";
	/**
	 * The name of the element, used for form submission or lookup.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#name)
	 */
	name: string;
	/**
	 * Submits the form without validating it.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#novalidate)
	 */
	novalidate: boolean;
	/**
	 * The relation of the linked resource to this document.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#rel)
	 */
	rel: string;
	/**
	 * Where the response or linked page is shown. Common values: `_self`, `_blank`, `_parent`,
	 * `_top`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#target)
	 */
	target: string;
	/**
	 * Same as `novalidate`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#novalidate)
	 */
	noValidate: boolean;
	/**
	 * Deprecated. The file types a file input accepts.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#accept)
	 */
	accept: string;
}

/** Attributes of `<iframe>` beyond the global ones. */
export interface HtmlIframeAttributes {
	/**
	 * The permissions policy granted to the embedded page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#allow)
	 */
	allow: string;
	/**
	 * Lets the embedded page go full screen.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#allowfullscreen)
	 */
	allowfullscreen: boolean;
	/**
	 * The height, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#height)
	 */
	height: number | string;
	/**
	 * Whether the resource loads at once or only when near the viewport.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#loading)
	 */
	loading: "eager" | "lazy";
	/**
	 * The name of the embedded browsing context, usable as a link target.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#name)
	 */
	name: string;
	/**
	 * How much referrer information is sent with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#referrerpolicy)
	 */
	referrerpolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Restrictions applied to the embedded page. Common values: `allow-downloads-without-user-
	 * activation`, `allow-downloads`, `allow-forms`, `allow-modals`, `allow-orientation-lock`,
	 * `allow-pointer-lock`, `allow-popups`, `allow-popups-to-escape-sandbox`, `allow-presentation`,
	 * `allow-same-origin`, `allow-scripts`, `allow-storage-access-by-user-activation`, `allow-top-
	 * navigation`, `allow-top-navigation-by-user-activation`, `allow-top-navigation-to-custom-
	 * protocols`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#sandbox)
	 */
	sandbox: string;
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#src)
	 */
	src: string;
	/**
	 * Inline HTML for the embedded page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#srcdoc)
	 */
	srcdoc: string;
	/**
	 * The width, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#width)
	 */
	width: number | string;
	/**
	 * Same as `referrerpolicy`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#referrerpolicy)
	 */
	referrerPolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Asks the browser to send ad auction headers with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#adauctionheaders)
	 */
	adauctionheaders: boolean;
	/**
	 * Sends the selected Topics API topics with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#browsingtopics)
	 */
	browsingtopics: boolean;
	/**
	 * Loads the embedded page in a fresh, credential-less context.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#credentialless)
	 */
	credentialless: boolean;
	/**
	 * The content security policy the embedded page must follow.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#csp)
	 */
	csp: string;
	/**
	 * A private state token request sent with the fetch.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#privatetoken)
	 */
	privatetoken: string;
	/**
	 * Lets the response write to shared storage.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#sharedstoragewritable)
	 */
	sharedstoragewritable: boolean;
	/**
	 * Deprecated. Horizontal alignment of the content.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#align)
	 */
	align: string;
	/**
	 * Deprecated. Lets the embedded page use the Payment Request API.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#allowpaymentrequest)
	 */
	allowpaymentrequest: boolean;
	/**
	 * Deprecated. Lets the embedded page draw a transparent background.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#allowtransparency)
	 */
	allowtransparency: boolean;
	/**
	 * Deprecated. Whether a border is drawn around the frame.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#frameborder)
	 */
	frameborder: number | string;
	/**
	 * Deprecated. A URL to a longer description.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#longdesc)
	 */
	longdesc: string;
	/**
	 * Deprecated. The top and bottom margin of the frame.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#marginheight)
	 */
	marginheight: number | string;
	/**
	 * Deprecated. The left and right margin of the frame.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#marginwidth)
	 */
	marginwidth: number | string;
	/**
	 * Deprecated. Whether the frame shows scroll bars.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#scrolling)
	 */
	scrolling: "yes" | "no" | "auto";
	/**
	 * Deprecated. Draws the frame as part of the containing page.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#seamless)
	 */
	seamless: boolean;
}

/** Attributes of `<img>` beyond the global ones. */
export interface HtmlImgAttributes {
	/**
	 * Text that replaces the image when it cannot be shown.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#alt)
	 */
	alt: string;
	/**
	 * Whether the request is made with CORS, and with which credentials.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#crossorigin)
	 */
	crossorigin: "anonymous" | "use-credentials" | "";
	/**
	 * Whether the image is decoded synchronously or asynchronously.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#decoding)
	 */
	decoding: "sync" | "async" | "auto";
	/**
	 * The priority of the fetch relative to others.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#fetchpriority)
	 */
	fetchpriority: "high" | "low" | "auto";
	/**
	 * The height, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#height)
	 */
	height: number | string;
	/**
	 * Makes the image a server-side image map.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#ismap)
	 */
	ismap: boolean;
	/**
	 * Whether the resource loads at once or only when near the viewport.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#loading)
	 */
	loading: "eager" | "lazy";
	/**
	 * How much referrer information is sent with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#referrerpolicy)
	 */
	referrerpolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Image sizes for different page layouts.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#sizes)
	 */
	sizes: string;
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#src)
	 */
	src: string;
	/**
	 * Candidate image sources for different sizes and densities.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#srcset)
	 */
	srcset: string;
	/**
	 * The image map used by the image.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#usemap)
	 */
	usemap: string;
	/**
	 * The width, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#width)
	 */
	width: number | string;
	/**
	 * Registers an attribution source or trigger with the request.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#attributionsrc)
	 */
	attributionsrc: string;
	/**
	 * Lets the response write to shared storage.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#sharedstoragewritable)
	 */
	sharedstoragewritable: boolean;
	/**
	 * Same as `crossorigin`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#crossorigin)
	 */
	crossOrigin: "anonymous" | "use-credentials" | "";
	/**
	 * Same as `ismap`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#ismap)
	 */
	isMap: boolean;
	/**
	 * Same as `referrerpolicy`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#referrerpolicy)
	 */
	referrerPolicy:
		"no-referrer" |
		"no-referrer-when-downgrade" |
		"origin" |
		"origin-when-cross-origin" |
		"same-origin" |
		"strict-origin" |
		"strict-origin-when-cross-origin" |
		"unsafe-url";
	/**
	 * Same as `srcset`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#srcset)
	 */
	srcSet: string;
	/**
	 * Same as `usemap`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#usemap)
	 */
	useMap: string;
	/**
	 * Deprecated. Horizontal alignment of the content.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#align)
	 */
	align: "top" | "middle" | "bottom" | "left" | "right";
	/**
	 * Deprecated. The width of the border.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#border)
	 */
	border: string;
	/**
	 * Deprecated. Whitespace left and right of the element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#hspace)
	 */
	hspace: number | string;
	/**
	 * Deprecated. The intrinsic size of the image before it loads.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#intrinsicsize)
	 */
	intrinsicsize: string;
	/**
	 * Deprecated. A URL to a longer description.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#longdesc)
	 */
	longdesc: string;
	/**
	 * Deprecated. A low-quality image shown while the full one loads.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#lowsrc)
	 */
	lowsrc: string;
	/**
	 * Deprecated. The name of the element, used for form submission or lookup.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#name)
	 */
	name: string;
	/**
	 * Deprecated. Whitespace above and below the element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/img#vspace)
	 */
	vspace: number | string;
}

/** Attributes of `<input>` beyond the global ones. */
export interface HtmlInputAttributes {
	/**
	 * The file types a file input accepts.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#accept)
	 */
	accept: string;
	/**
	 * Lets a color input pick an alpha channel.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#alpha)
	 */
	alpha: boolean;
	/**
	 * Text that replaces the image when it cannot be shown.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#alt)
	 */
	alt: string;
	/**
	 * Which value the browser may fill in automatically. Common values: `additional-name`,
	 * `address-level1`, `address-level2`, `address-level3`, `address-level4`, `address-line1`,
	 * `address-line2`, `address-line3`, `bday`, `bday-day`, `bday-month`, `bday-year`, `billing`,
	 * `cc-additional-name`, `cc-csc`, `cc-exp`, `cc-exp-month`, `cc-exp-year`, `cc-family-name`,
	 * `cc-given-name`, `cc-name`, `cc-number`, `cc-type`, `country`, `country-name`, `current-
	 * password`, `email`, `family-name`, `fax`, `given-name`, `home`, `honorific-prefix`,
	 * `honorific-suffix`, `impp`, `language`, `mobile`, `name`, `new-password`, `nickname`, `off`,
	 * `on`, `organization`, `organization-title`, `pager`, `photo`, `postal-code`, `sex`,
	 * `shipping`, `street-address`, `tel`, `tel-area-code`, `tel-country-code`, `tel-extension`,
	 * `tel-local`, `tel-local-prefix`, `tel-local-suffix`, `tel-national`, `transaction-amount`,
	 * `transaction-currency`, `url`, `username`, `work`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#autocomplete)
	 */
	autocomplete: string;
	/**
	 * Which camera or microphone a file input captures from.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#capture)
	 */
	capture: "user" | "environment";
	/**
	 * Whether the checkbox or radio button is selected.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#checked)
	 */
	checked: boolean;
	/**
	 * The color space a color input picks in.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#colorspace)
	 */
	colorspace: string;
	/**
	 * Submits the text direction under this field name.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#dirname)
	 */
	dirname: string;
	/**
	 * Disables the control: it cannot be focused, edited or submitted.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#disabled)
	 */
	disabled: boolean;
	/**
	 * The id of the form this control belongs to.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#form)
	 */
	form: string;
	/**
	 * The URL this button submits to, overriding the form's action.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formaction)
	 */
	formaction: string;
	/**
	 * The encoding this button submits with, overriding the form's enctype.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formenctype)
	 */
	formenctype: "application/x-www-form-urlencoded" | "multipart/form-data" | "text/plain";
	/**
	 * The method this button submits with, overriding the form's method.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formmethod)
	 */
	formmethod: "post" | "get" | "dialog";
	/**
	 * Submits without validating, overriding the form.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formnovalidate)
	 */
	formnovalidate: boolean;
	/**
	 * Where this button shows the response, overriding the form's target.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formtarget)
	 */
	formtarget: string;
	/**
	 * The height, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#height)
	 */
	height: number | string;
	/**
	 * The id of a datalist that suggests values.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#list)
	 */
	list: string;
	/**
	 * The largest allowed value.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#max)
	 */
	max: number | string;
	/**
	 * The most characters the user may enter.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#maxlength)
	 */
	maxlength: number | string;
	/**
	 * The smallest allowed value.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#min)
	 */
	min: number | string;
	/**
	 * The fewest characters the user must enter.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#minlength)
	 */
	minlength: number | string;
	/**
	 * Allows more than one value.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#multiple)
	 */
	multiple: boolean;
	/**
	 * The name of the element, used for form submission or lookup.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#name)
	 */
	name: string;
	/**
	 * A regular expression the value must match.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#pattern)
	 */
	pattern: string;
	/**
	 * A hint shown while the control is empty.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#placeholder)
	 */
	placeholder: string;
	/**
	 * The id of the popover this button controls.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#popovertarget)
	 */
	popovertarget: string;
	/**
	 * Whether the button shows, hides or toggles the popover.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#popovertargetaction)
	 */
	popovertargetaction: "hide" | "show" | "toggle";
	/**
	 * The user cannot edit the value, but it is still submitted.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#readonly)
	 */
	readonly: boolean;
	/**
	 * The control must have a value before the form submits.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#required)
	 */
	required: boolean;
	/**
	 * How many past searches a search input remembers, in Safari.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#results)
	 */
	results: number;
	/**
	 * The visible size of the control.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#size)
	 */
	size: number | string;
	/**
	 * The URL of the resource to embed.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#src)
	 */
	src: string;
	/**
	 * The granularity of allowed values.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#step)
	 */
	step: number | string;
	/**
	 * The kind of control: text, checkbox, date and so on. Common values: `button`, `checkbox`,
	 * `color`, `date`, `datetime-local`, `email`, `file`, `hidden`, `image`, `month`, `number`,
	 * `password`, `radio`, `range`, `reset`, `search`, `submit`, `tel`, `text`, `time`, `url`,
	 * `week`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#type)
	 */
	type: string;
	/**
	 * The value of the element.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#value)
	 */
	value: number | string;
	/**
	 * The width, in CSS pixels.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#width)
	 */
	width: number | string;
	/**
	 * Fires search events while the user types.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#incremental)
	 */
	incremental: boolean;
	/**
	 * Same as `formaction`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formaction)
	 */
	formAction: string;
	/**
	 * Same as `formenctype`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formenctype)
	 */
	formEnctype: "application/x-www-form-urlencoded" | "multipart/form-data" | "text/plain";
	/**
	 * Same as `formmethod`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formmethod)
	 */
	formMethod: "post" | "get" | "dialog";
	/**
	 * Same as `formnovalidate`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formnovalidate)
	 */
	formNoValidate: boolean;
	/**
	 * Same as `formtarget`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#formtarget)
	 */
	formTarget: string;
	/**
	 * Same as `maxlength`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#maxlength)
	 */
	maxLength: number | string;
	/**
	 * Same as `minlength`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#minlength)
	 */
	minLength: number | string;
	/**
	 * Same as `readonly`.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#readonly)
	 */
	readOnly: boolean;
	/**
	 * Deprecated. Horizontal alignment of the content.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#align)
	 */
	align: string;
	/**
	 * Deprecated. The image map used by the image.
	 * [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/input#usemap)
	 */
	usemap: string;
