		addEvent: (node: HostNode, name: string, handler: (e: NeonEvent) => void): void => {
			const type = eventType(name);
			if (addMediaEvent(node, type, handler)) { return; }
			// RN surface names project onto DOM listeners; e.type keeps the neon
			// spelling so handlers compare one vocabulary on every host.
			let domType = type;
			if (type === "press") { domType = "click"; }
			else if (type === "changetext") { domType = "input"; }
			else if (type === "submitediting") { domType = "keydown"; }
			else if (type === "valuechange") { domType = "change"; }
			const el = node as unknown as Node;
			if (type === "press" || type === "click") { presses.set(el, true); }
			if (scrolls.has(el) && (type === "scroll" || type === "scrollbegindrag" || type === "scrollenddrag" || type === "momentumscrollbegin" || type === "momentumscrollend" || type === "refresh")) {
				(scrolls.get(el) as DomScrollState).routes.push({ type, handler });
				return;
			}
			if (type === "requestclose") {
				const escape = (de: DomEvent): void => {
					if (de.key !== "Escape") { return; }
					const ev = neonEvent(type);
					ev.timeStamp = de.timeStamp;
					handler(ev);
				};
				window.addEventListener("keydown", escape);
				keep(el, (): void => { window.removeEventListener("keydown", escape); });
				return;
			}
			if (type === "touchstart" || type === "touchmove" || type === "touchend" || type === "touchcancel") {
				watchTouches();
				if (!touchRoutes.has(el)) {
					touchRoutes.set(el, []);
					listen(el, "pointerdown", (de: DomEvent): void => {
						if (de.timeStamp !== touchStamp) {
							touchStamp = de.timeStamp;
							touchElements = [];
							touchPointer = de.pointerId;
						}
						touchElements.push(el);
						fireTouchRoutes(el, "touchstart", de);
					}, false);
					keep(el, (): void => { touchRoutes.delete(el); });
				}
				(touchRoutes.get(el) as DomTouchRoute[]).push({ type, handler });
				return;
			}
			if (type === "layout") {
				const state = new DomLayoutState(el, handler);
				layouts.push(state);
				const observer = new ResizeObserver((): void => { if (state.active) { scheduleLayouts(); } });
				observer.observe(el);
				scheduleLayouts();
				keep(el, (): void => { state.active = false; observer.disconnect(); scheduleLayouts(); });
				return;
			}
			listen(el, domType, (de: DomEvent): void => {
				if (type === "submitediting" && (de.key !== "Enter" || de.isComposing)) { return; }
				if (type === "press") {
					let owner: Node | null = de.target;
					while (owner !== null && !presses.has(owner as Node)) { owner = (owner as Node).parentNode; }
					if (owner !== el) { return; }
				}
				const ev = neonEvent(type);
				ev.pointerOrigin = pointerOrigin(de);
				ev.timeStamp = de.timeStamp;
				if (type === "valuechange") {
					ev.value = el.checked ? "true" : "false";
					handler(ev);
					if (switchValues.has(el)) { el.checked = switchValues.get(el) as boolean; }
					return;
				}
				if (type === "load" && controlKinds.has(el)) {
					ev.width = el.naturalWidth;
					ev.height = el.naturalHeight;
				}
				if (type === "error" && controlKinds.has(el)) { ev.value = "cannot load the image"; }
				if (type === "changetext" || type === "input" || type === "change" || type === "submitediting") { ev.value = de.target.value; }
				else if (type === "selectionchange") { ev.value = `${el.selectionStart},${el.selectionEnd}`; }
				else if (type === "scroll") {
					ev.x = el.scrollLeft;
					ev.y = el.scrollTop;
					ev.width = el.offsetWidth;
					ev.height = el.offsetHeight;
					ev.contentWidth = el.scrollWidth;
					ev.contentHeight = el.scrollHeight;
				}
				else if (type === "keydown" || type === "keyup" || type === "keypress") {
					ev.key = de.key;
					ev.code = de.code;
					ev.altKey = de.altKey;
					ev.ctrlKey = de.ctrlKey;
					ev.metaKey = de.metaKey;
					ev.shiftKey = de.shiftKey;
					ev.repeat = de.repeat;
					ev.isComposing = de.isComposing;
				}
				else if (type === "press" || type === "click" || type === "dblclick" || type === "mousedown" || type === "mouseup" || type === "mousemove" || type.startsWith("pointer")) {
					ev.x = de.clientX;
					ev.y = de.clientY;
				}
				if (type === "press" && ev.pointerOrigin && lastPointerUp >= 0) {
					ev.timeStamp = lastPointerUp;
				}
				handler(ev);
			}, false);
		},
		append: (parent: HostNode, child: HostNode): void => {
			prepareVisibleContent();
			(parent as unknown as Node).appendChild(child as unknown as Node);
			const el = parent as unknown as Node;
			if (scrolls.has(el)) { (scrolls.get(el) as DomScrollState).mountRefresh(); }
			scheduleLayouts();
		},
		insertBefore: (parent: HostNode, node: HostNode, ref: HostNode | null): void => {
			prepareVisibleContent();
			const el = parent as unknown as Node;
			const moved = shownInHead(node as unknown as Node) as Node;
			const before = ref === null ? null : shownInHead(ref as unknown as Node);
			if (moved.isConnected && el.isConnected && Reflect.has(el, "moveBefore")) {
				el.moveBefore(moved, before);
			} else {
				el.insertBefore(moved, before);
			}
			if (el === (document.head as unknown as Node)) { enterHead(moved); }
			if (scrolls.has(el)) { (scrolls.get(el) as DomScrollState).mountRefresh(); }
			scheduleLayouts();
		},
		removeChild: (parent: HostNode, node: HostNode): void => {
			prepareVisibleContent();
			release(node as unknown as Node);
			const el = parent as unknown as Node;
			el.removeChild(el === (document.head as unknown as Node) ? leaveHead(node as unknown as Node) : node as unknown as Node);
			scheduleLayouts();
		},
		parentOf: (node: HostNode): HostNode | null => {
			const p = (shownInHead(node as unknown as Node) as Node).parentNode;
			if (p === null) { return null; }
			return p as unknown as HostNode;
		},
		release: (node: HostNode): void => {
			if ((shownInHead(node as unknown as Node) as Node).parentNode !== null) { throw "release: the node still has a parent; remove it first"; }
			release(node as unknown as Node);
		},
		nextSibling: (node: HostNode): HostNode | null => {
			return heldByHead((shownInHead(node as unknown as Node) as Node).nextSibling as Node | null) as unknown as HostNode;
		},
		firstChild: (node: HostNode): HostNode | null => {
			return heldByHead((node as unknown as Node).firstChild as Node | null) as unknown as HostNode;
		},
		cloneNode: (node: HostNode): HostNode => {
			return (node as unknown as Node).cloneNode(true) as unknown as HostNode;
		},
		voidArea: null,
		measureInWindow: measureDomWindow,
		measureLayout: measureDomLayout,
		overlayRoot: (node: HostNode): HostNode => document.body as unknown as HostNode,
		headRoot: (node: HostNode): HostNode => {
			dropServedHead();
			return document.head as unknown as HostNode;
		},
		claim: (parent: HostNode, after: HostNode | null, tag: string): HostNode | null => {
			const el = parent as unknown as Node;
			let next = (after === null ? el.firstChild : (after as unknown as Node).nextSibling) as Node | null;
			while (next !== null && (next as Node).nodeType === 8 && (next as Node).data === "!") {
				const separator = next as Node;
				next = separator.nextSibling as Node | null;
				el.removeChild(separator);
			}
			if (next === null) { return null; }
			const found = next as Node;
			if (tag === "") {
				if (found.nodeType === 3) { return found as unknown as HostNode; }
				if (found.nodeType !== 8 || found.data !== "") { return null; }
				const blank = document.createTextNode("");
				el.replaceChild(blank, found);
				return blank as unknown as HostNode;
			}
			if (found.nodeType !== 1 || found.localName !== (tag === "image" ? IMAGE_TAG : webHtmlTag(tag))) { return null; }
			if (tag === "pressable") {
				presses.set(found, true);
				keep(found, (): void => { presses.delete(found); });
			}
			registerRules(tag);
			if (isMediaTag(tag)) { return adoptMedia(found as unknown as HostNode, tag); }
			if (tag === "image") { return adoptImage(found); }
			if (tag === "svg") { return adoptSvg(found); }
			if (tag === "scrollview") { return adoptScroll(found); }
			if (tag === "switch" || tag === "activityindicator") { return adoptControl(tag, found); }
			if (tag === "multilinetextinput") {
				const typed: string = found.value;
				found.textContent = "";
				found.value = typed;
				found.classList.add(webControlClass(tag));
			}
			return found as unknown as HostNode;
		},
		focus: (node: HostNode, focused: boolean): void => {
			const el = node as unknown as Node;
			if (focused) { el.focus(); } else { el.blur(); }
		},
		scrollTo: (node: HostNode, x: number, y: number, animated: boolean): void => {
			(node as unknown as Node).scroll({ left: x, top: y, behavior: animated ? "smooth" : "auto" });
		},
		measureText: measureDomText,
		setResponder: (node: HostNode | null, blockNativeResponder: boolean): void => {
			if (node === null || touchPointer < 0) { return; }
			try {
				(node as unknown as Node).setPointerCapture(touchPointer);
			} catch (e) {
				touchPointer = -1;
			}
		},
	};
}
