// Browser DOM host — JS backend only. Same render(node, host, parent)
// drives this; here the host ops map to real document.* / Node APIs.

import { Host, HostNode, TextMeasure } from "../../render/host";
import { MeasureRect, MeasureError } from "../../render/hostTypes";
import { Style, StyleValue } from "../../render/style";
import { registerCss, collectCss, onCssChange } from "../../render/sheet";
import { NeonEvent, neonEvent, eventType } from "../../render/event";
import { onCleanup } from "../../core/cleanup";
import { getOwner } from "../../core/runtime";
import {
	VIEW_CLASS,
	TEXT_CLASS,
	CONTROL_CSS,
	CONTROL_RULES_ID,
	ControlAttr,
	LINES_CLASS,
	SCROLL_CLASS,
	WebRule,
	TEXT_CSS,
	TEXT_RULES_ID,
	controlAttr,
	clampedLines,
	linesClass,
	linesRule,
	SERVED_HEAD,
	scrollLook,
	webBaseClass,
	webControlClass,
	webFixedAttrs,
	webHtmlTag,
	webRules,
	domAttrName,
	BLUR_PREFIX,
	IMAGE_CLASS,
	IMAGE_TAG,
	TILE_PREFIX,
	blurRule,
	svgPrefix,
	tileRule,
	domAttrValue,
} from "../../render/web";
import { publishWindow, publishColorScheme } from "../../render/environment";
import { publishSafeArea } from "../../render/environment";
import { publishPageScroll } from "../../api/pageScroll";
import { CssStyle, applyCss, applyCssProp } from "./domCss";
import { VisibleContentPosition, parseVisibleContent } from "../../render/visibleContent";
import { installBrowserAppServices } from "./appServices";
import { isMediaTag, createMediaNode, adoptMedia, writeMediaAttr, addMediaEvent, releaseMedia, writeSvgList } from "./domCapabilities";

extern class ClassList {
	extern add(name: cstring): void;
	extern remove(name: cstring): void;
	extern toggle(name: cstring): void;
	extern contains(name: cstring): boolean;
}

extern class DomRect {
	left: number;
	top: number;
	width: number;
	height: number;
}

extern class DomRectList { length: int32; }

extern class Reflect {
	static extern has(target: Node, key: cstring): boolean;
}

extern class ResizeObserver {
	extern observe(target: Node): void;
	extern disconnect(): void;
}

interface DomScrollOptions {
	left: number;
	top: number;
	behavior: string;
}

extern class Node {
	textContent: cstring;
	innerHTML: cstring;
	scrollLeft: number;
	scrollTop: number;
	scrollWidth: number;
	scrollHeight: number;
	clientWidth: number;
	clientHeight: number;
	offsetWidth: number;
	offsetHeight: number;
	offsetLeft: number;
	offsetTop: number;
	clientLeft: number;
	clientTop: number;
	offsetParent: Node | null;
	parentNode: Node | null;
	isConnected: boolean;
	nodeType: number;
	tagName: string;
	localName: string;
	data: string;
	className: string;
	extern blur(): void;
	extern focus(): void;
	extern contains(node: Node): boolean;
	extern scroll(options: DomScrollOptions): void;
	extern getBoundingClientRect(): DomRect;
	extern getClientRects(): DomRectList;
	style: CssStyle;
	classList: ClassList;
	nextSibling: Node;
	firstChild: Node;
	extern cloneNode(deep: boolean): Node;
	extern appendChild(child: Node): void;
	extern insertBefore(node: Node, ref: Node | null): void;
	extern moveBefore(node: Node, ref: Node | null): void;
	isConnected: boolean;
	extern removeChild(child: Node): void;
	extern replaceChild(node: Node, old: Node): void;
	value: cstring;
	checked: boolean;
	naturalWidth: number;
	naturalHeight: number;
	selectionStart: number;
	selectionEnd: number;
	extern setSelectionRange(start: number, end: number): void;
	extern getAttribute(name: cstring): string | null;
	extern setAttribute(name: cstring, value: cstring): void;
	extern removeAttribute(name: cstring): void;
	extern addEventListener(name: cstring, handler: (e: DomEvent) => void, capture: boolean): void;
	extern removeEventListener(name: cstring, handler: (e: DomEvent) => void, capture: boolean): void;
	extern setPointerCapture(pointerId: number): void;
}

function cssomLayoutOrigin(node: Node): [float64, float64] {
	let x = 0.0;
	let y = 0.0;
	let at: Node | null = node;
	while (at !== null) {
		const current = at as Node;
		x += current.offsetLeft;
		y += current.offsetTop;
		const parent = current.offsetParent;
		if (parent !== null) {
			x += (parent as Node).clientLeft;
			y += (parent as Node).clientTop;
		}
		at = parent;
	}
	return [x, y];
}

function measureDomWindow(node: HostNode): Result<MeasureRect, MeasureError> {
	const el = node as unknown as Node;
	if (!el.isConnected) { return Result.err(MeasureError.NotMounted); }
	if (el.getClientRects().length === 0) { return Result.err(MeasureError.NotLaidOut); }
	const rect = el.getBoundingClientRect();
	return Result.ok({ x: rect.left, y: rect.top, width: rect.width, height: rect.height });
}

function measureDomLayout(node: HostNode, ancestor: HostNode): Result<MeasureRect, MeasureError> {
	const el = node as unknown as Node;
	const parent = ancestor as unknown as Node;
	if (!el.isConnected || !parent.isConnected) { return Result.err(MeasureError.NotMounted); }
	if (!parent.contains(el)) { return Result.err(MeasureError.NotAncestor); }
	if (el.getClientRects().length === 0 || parent.getClientRects().length === 0) { return Result.err(MeasureError.NotLaidOut); }
	const [x, y] = cssomLayoutOrigin(el);
	const [parentX, parentY] = cssomLayoutOrigin(parent);
	return Result.ok({ x: x - parentX, y: y - parentY, width: el.offsetWidth, height: el.offsetHeight });
}

extern class DomTouch {
	clientX: number;
	clientY: number;
}

extern class DomTouchList {
	length: number;
	extern item(index: number): DomTouch;
}

extern class CSSStyleDeclaration {
	overflowX: string;
	overflowY: string;
	scrollbarWidth: string;
	touchAction: string;
	overscrollBehaviorY: string;
	overflowAnchor: string;
	position: string;
	color: string;
}

// Only the fields Neon projects onto NeonEvent. Each is read ONLY for the event
// types that always carry it (`value` on input/change, `key` on the key events,
// clientX/Y on the mouse ones) — a DOM event object simply lacks the others, and
// there is no way to probe for absence across the extern boundary.
extern class DomEvent {
	target: Node;
	timeStamp: number;
	clientX: number;
	clientY: number;
	key: string;
	code: string;
	altKey: boolean;
	ctrlKey: boolean;
	metaKey: boolean;
	shiftKey: boolean;
	repeat: boolean;
	isComposing: boolean;
	touches: DomTouchList;
	pointerId: number;
	defaultPrevented: boolean;
	extern preventDefault(): void;
	extern stopPropagation(): void;
}

extern function pointerOrigin(e: DomEvent): boolean from
	"((e) => typeof e.pointerType === 'string' && e.pointerType.length > 0)(#)";

extern class MediaQueryList {
	matches: boolean;
	extern addEventListener(name: cstring, handler: (e: DomEvent) => void): void;
}

extern class ComputedFont {
	fontFamily: string;
	fontSize: string;
}

extern class CanvasTextMetrics {
	width: number;
	fontBoundingBoxAscent: number;
	fontBoundingBoxDescent: number;
}

extern class Canvas2D {
	font: string;
	extern measureText(text: cstring): CanvasTextMetrics;
}

extern class HTMLCanvasElement {
	extern getContext(kind: cstring): Canvas2D;
}

extern class window {
	static innerWidth: number;
	static innerHeight: number;
	static scrollX: number;
	static scrollY: number;
	static extern addEventListener(name: cstring, handler: (e: DomEvent) => void): void;
	static extern matchMedia(query: cstring): MediaQueryList;
	static extern removeEventListener(name: cstring, handler: (e: DomEvent) => void): void;
	static extern getComputedStyle(node: Node): ComputedFont;
}

let measureCanvas: Canvas2D | null = null;

function measureDomText(text: string, style: Style): TextMeasure {
	if (measureCanvas === null) {
		measureCanvas = (document.createElement("canvas") as unknown as HTMLCanvasElement).getContext("2d");
	}
	const ctx = measureCanvas as Canvas2D;
	const page = window.getComputedStyle(document.body);
	const family = style.fontFamily !== null ? style.fontFamily as string : page.fontFamily;
	const size = style.fontSize !== null ? `${style.fontSize as number}px` : page.fontSize;
	const weight = style.fontWeight !== null ? `${style.fontWeight as string}` : "normal";
	const slant = style.fontStyle !== null ? style.fontStyle as string : "normal";
	ctx.font = `${slant} ${weight} ${size} ${family}`;
	const m = ctx.measureText(text);
	return {
		width: m.width,
		height: m.fontBoundingBoxAscent + m.fontBoundingBoxDescent,
		ascender: m.fontBoundingBoxAscent,
		descender: m.fontBoundingBoxDescent,
	};
}

// A Modal's layer covers the viewport even when the page scrolls, and its
// animationType plays once as it appears.
const MODAL_CSS = ".neon-modal{position:fixed !important}.neon-modal[animationtype=fade]{animation:neon-modal-fade .3s ease-out}.neon-modal[animationtype=slide]{animation:neon-modal-slide .3s ease-out}@keyframes neon-modal-fade{from{opacity:0}to{opacity:1}}@keyframes neon-modal-slide{from{transform:translateY(100vh)}to{transform:none}}";

let environmentWatched = false;

function watchEnvironment(): void {
	if (environmentWatched) { return; }
	environmentWatched = true;
	const scheme = window.matchMedia("(prefers-color-scheme: dark)");
	const publish = (): void => {
		publishWindow(window.innerWidth, window.innerHeight);
		publishColorScheme(scheme.matches ? "dark" : "light");
	};
	publish();
	window.addEventListener("resize", (e: DomEvent): void => { publish(); });
	scheme.addEventListener("change", (e: DomEvent): void => { publish(); });
}

let pageScrollWatched = false;

function watchPageScroll(): void {
	if (pageScrollWatched) { return; }
	pageScrollWatched = true;
	const root = document.documentElement;
	const publish = (): void => {
		publishPageScroll(
			window.scrollX,
			window.scrollY,
			Math.max(0, root.scrollWidth - root.clientWidth),
			Math.max(0, root.scrollHeight - root.clientHeight),
		);
	};
	publish();
	window.addEventListener("scroll", (e: DomEvent): void => { publish(); });
	window.addEventListener("resize", (e: DomEvent): void => { publish(); });
	const observer = new ResizeObserver(publish);
	observer.observe(root);
	observer.observe(document.body);
}

let safeAreaWatched = false;

// CSS env(safe-area-inset-*) has no script API: four hidden probes take one
// inset each as their height, read back after every resize.
function watchSafeArea(): void {
	if (safeAreaWatched) { return; }
	safeAreaWatched = true;
	const probe = document.createElement("div");
	probe.setAttribute("aria-hidden", "true");
	probe.setAttribute("style", "position:fixed;left:0;top:0;width:0;height:0;overflow:hidden;visibility:hidden;pointer-events:none");
	const edges: Node[] = [];
	for (const edge of ["top", "right", "bottom", "left"]) {
		const one = document.createElement("div");
		one.setAttribute("style", `width:0;height:env(safe-area-inset-${edge}, 0px)`);
		probe.appendChild(one);
		edges.push(one);
	}
	document.body.appendChild(probe);
	const publish = (): void => {
		publishSafeArea(edges[0].offsetHeight, edges[1].offsetHeight, edges[2].offsetHeight, edges[3].offsetHeight);
	};
	publish();
	window.addEventListener("resize", (e: DomEvent): void => { publish(); });
}

extern function requestAnimationFrame(callback: (time: number) => void): number;
extern function cancelAnimationFrame(id: number): void;
extern function queueMicrotask(callback: () => void): void;

const ELEMENT_NODE = 1;

function layoutStart(node: Node, horizontal: boolean): number {
	let start = 0.0;
	let at: Node | null = node;
	while (at !== null) {
		start += horizontal ? (at as Node).offsetLeft : (at as Node).offsetTop;
		at = (at as Node).offsetParent;
	}
	return start;
}

interface DomScrollRoute {
	type: string;
	handler: (e: NeonEvent) => void;
}

class DomScrollState {
	el: Node;
	horizontal: boolean = false;
	enabled: boolean = true;
	horizontalIndicator: boolean = true;
	verticalIndicator: boolean = true;
	paging: boolean = false;
	dismiss: string = "none";
	taps: string = "never";
	refreshEnabled: boolean = false;
	refreshTint: string = "black";
	refreshBackground: string = "white";
	refreshing: boolean = false;
	refreshPending: boolean = false;
	touching: boolean = false;
	dragging: boolean = false;
	momentum: boolean = false;
	startX: number = 0;
	startY: number = 0;
	pull: number = 0;
	frame: number = -1;
	stableFrames: int32 = 0;
	lastX: number = -1;
	lastY: number = -1;
	indicator: Node | null = null;
	routes: DomScrollRoute[] = [];
	visibleContent: VisibleContentPosition | null = null;
	anchor: Node | null = null;
	anchorStart: number = 0;
	shifted: boolean = false;

	constructor(el: Node) { this.el = el; }

	content(): Node | null {
		let child = this.el.firstChild as Node | null;
		while (child !== null && (child as Node).nodeType !== ELEMENT_NODE) {
			child = (child as Node).nextSibling as Node | null;
		}
		return child;
	}

	// RN RCTScrollViewComponentView _prepareForMaintainVisibleScrollPosition, before a batch of
	// host writes instead of a mount transaction.
	prepareVisibleContent(): void {
		this.anchor = null;
		const position = this.visibleContent;
		const content = this.content();
		if (position === null || content === null || !this.el.isConnected) { return; }
		const offset = this.horizontal ? this.el.scrollLeft : this.el.scrollTop;
		const origin = layoutStart(content as Node, this.horizontal);
		let index: int32 = 0;
		let child = (content as Node).firstChild as Node | null;
		while (child !== null) {
			const node = child as Node;
			child = node.nextSibling as Node | null;
			if (node.nodeType !== ELEMENT_NODE) { continue; }
			index += 1;
			if (index <= (position as VisibleContentPosition).minIndexForVisible) { continue; }
			const start = layoutStart(node, this.horizontal) - origin;
			this.anchor = node;
			this.anchorStart = start;
			const length = this.horizontal ? node.offsetWidth : node.offsetHeight;
			if (start + length > offset) { break; }
		}
	}

	adjustVisibleContent(): void {
		const anchor = this.anchor;
		const position = this.visibleContent;
		const content = this.content();
		this.anchor = null;
		if (anchor === null || position === null || content === null) { return; }
		if ((anchor as Node).parentNode !== content) { return; }
		const origin = layoutStart(content as Node, this.horizontal);
		const delta = layoutStart(anchor as Node, this.horizontal) - origin - this.anchorStart;
		if (Math.abs(delta) <= 0.5) { return; }
		const before = this.horizontal ? this.el.scrollLeft : this.el.scrollTop;
		if (this.horizontal) {
			this.el.scrollLeft = before + delta;
		} else {
			this.el.scrollTop = before + delta;
		}
		this.shifted = (this.horizontal ? this.el.scrollLeft : this.el.scrollTop) !== before;
		const threshold = (position as VisibleContentPosition).autoscrollToTopThreshold;
		if (threshold !== null && before <= (threshold as number)) {
			this.el.scroll({
				left: this.horizontal ? 0 : this.el.scrollLeft,
				top: this.horizontal ? this.el.scrollTop : 0,
				behavior: "smooth",
			});
		}
	}

	fire(type: string): void {
		const e = neonEvent(type);
		e.timeStamp = performance.now();
		e.x = this.el.scrollLeft; e.y = this.el.scrollTop;
		e.width = this.el.offsetWidth; e.height = this.el.offsetHeight;
		e.contentWidth = this.el.scrollWidth; e.contentHeight = this.el.scrollHeight;
		for (const route of this.routes) { if (route.type === type) { route.handler(e); } }
	}

	beginDrag(): void {
		if (this.dragging || !this.enabled) { return; }
		if (this.momentum) { this.momentum = false; this.fire("momentumscrollend"); }
		this.dragging = true;
		if (this.dismiss === "on-drag") { blurInput(); }
		this.fire("scrollbegindrag");
	}

	beginMomentum(): void {
		if (this.momentum) { return; }
		this.momentum = true;
		this.stableFrames = 0;
		this.lastX = this.el.scrollLeft; this.lastY = this.el.scrollTop;
		this.fire("momentumscrollbegin");
		this.scheduleSettle();
	}

	scheduleSettle(): void {
		if (this.frame >= 0) { return; }
		this.frame = requestAnimationFrame((time: number): void => {
			this.frame = -1;
			if (!this.momentum) { return; }
			const x = this.el.scrollLeft;
			const y = this.el.scrollTop;
			if (x !== this.lastX || y !== this.lastY || this.touching) { this.stableFrames = 0; }
			else { this.stableFrames += 1; }
			this.lastX = x; this.lastY = y;
			if (this.stableFrames >= 3) { this.scrollEnd(); }
			if (this.momentum) { this.scheduleSettle(); }
		});
	}

	dispose(): void {
		if (this.frame >= 0) { cancelAnimationFrame(this.frame); }
		this.frame = -1;
		this.momentum = false;
		this.routes = [];
	}

	apply(): void {
		const css = this.el.style as unknown as CSSStyleDeclaration;
		const look = scrollLook(
			this.horizontal,
			this.enabled,
			this.horizontalIndicator,
			this.verticalIndicator,
			this.refreshEnabled,
			this.visibleContent !== null,
		);
		css.overflowX = look.overflowX;
		css.overflowY = look.overflowY;
		css.touchAction = look.touchAction;
		css.scrollbarWidth = look.scrollbarWidth;
		if (look.hideHorizontal) { this.el.classList.add("neon-hide-horizontal"); }
		else { this.el.classList.remove("neon-hide-horizontal"); }
		if (look.hideVertical) { this.el.classList.add("neon-hide-vertical"); }
		else { this.el.classList.remove("neon-hide-vertical"); }
		css.overscrollBehaviorY = look.overscrollBehaviorY;
		css.overflowAnchor = look.overflowAnchor;
		if (this.indicator !== null && (css.position === "" || css.position === "static")) { css.position = "relative"; }
	}

	showRefresh(): void {
		if (this.indicator === null) { return; }
		const indicator = this.indicator as Node;
		indicator.setAttribute("style", `position:absolute;top:8px;left:calc(50% - 14px);width:28px;height:28px;border-radius:50%;background:${this.refreshBackground};color:${this.refreshTint};text-align:center;line-height:28px;pointer-events:none;display:${this.refreshing || this.refreshPending || this.pull > 0 ? "block" : "none"}`);
		indicator.setAttribute("aria-busy", this.refreshing || this.refreshPending ? "true" : "false");
	}

	mountRefresh(): void {
		if (!this.refreshEnabled || this.indicator !== null) { return; }
		const indicator = document.createElement("div");
		indicator.textContent = "↻";
		indicator.classList.add("neon-refresh-indicator");
		indicator.setAttribute("role", "progressbar");
		indicator.setAttribute("aria-label", "Refreshing");
		this.indicator = indicator;
		(this.el.style as unknown as CSSStyleDeclaration).position = "relative";
		this.el.appendChild(indicator);
		this.showRefresh();
	}

	setOption(name: string, value: string): void {
		const yes = value === "true";
		const defaultYes = value === "" || yes;
		match (name) {
			"horizontal" => { this.horizontal = yes; },
			"scrollEnabled" => { this.enabled = defaultYes; },
			"showsHorizontalScrollIndicator" => { this.horizontalIndicator = defaultYes; },
			"showsVerticalScrollIndicator" => { this.verticalIndicator = defaultYes; },
			"pagingEnabled" => { this.paging = yes; },
			"keyboardDismissMode" => {
				if (value === "interactive") { throw "ScrollView: keyboardDismissMode interactive needs iOS's interactive keyboard; the browser supports none and on-drag"; }
				this.dismiss = value;
			},
			"keyboardShouldPersistTaps" => { this.taps = value === "" ? "never" : value; },
			"refreshTintColor" => { this.refreshTint = value === "" ? "black" : value; this.showRefresh(); },
			"refreshBackgroundColor" => { this.refreshBackground = value === "" ? "white" : value; this.showRefresh(); },
			"refreshEnabled" => {
				this.refreshEnabled = yes;
				if (this.el.firstChild !== null) { this.mountRefresh(); }
			},
			"refreshing" => { this.refreshing = yes; this.refreshPending = false; this.showRefresh(); },
			"maintainVisibleContentPosition" => {
				this.visibleContent = parseVisibleContent(value);
			},
			_ => {},
		}
		this.apply();
	}

	scrollEnd(): void {
		if (this.touching) { return; }
		if (this.paging) {
			const interval = this.horizontal ? this.el.offsetWidth : this.el.offsetHeight;
			const offset = this.horizontal ? this.el.scrollLeft : this.el.scrollTop;
			const length = this.horizontal ? this.el.scrollWidth : this.el.scrollHeight;
			if (interval > 0) {
				const target = Math.min(Math.max(0, length - interval), Math.round(offset / interval) * interval);
				if (Math.abs(target - offset) > 0.5) {
					this.beginMomentum();
					this.el.scroll({ left: this.horizontal ? target : 0, top: this.horizontal ? 0 : target, behavior: "smooth" });
					return;
				}
			}
		}
		if (this.momentum) { this.momentum = false; this.fire("momentumscrollend"); }
	}
}

const controlKinds = new Map<Node, string>();
const switchValues = new Map<Node, boolean>();

function writeControlAttr(el: Node, kind: string, name: string, value: string): boolean {
	if (kind === "switch" || kind === "activityindicator") {
		const written = controlAttr(kind, name, value);
		if (written === null) { return false; }
		const control = written as ControlAttr;
		if (kind === "switch" && name === "value") {
			el.checked = value === "true";
			switchValues.set(el, value === "true");
			return true;
		}
		if (control.name !== "") {
			if (control.value === null) { el.removeAttribute(control.name); }
			else { el.setAttribute(control.name, control.value as string); }
		}
		if (control.color !== "") { el.style.color = control.color; }
		return true;
	}
	if (kind === "image") {
		if (name === "source") {
			el.setAttribute("src", value);
			tileImage(el);
			return true;
		}
		if (name === "resizeMode") {
			el.setAttribute("data-resize", value);
			tileImage(el);
			return true;
		}
		if (name === "blurRadius") {
			swapClass(el, BLUR_PREFIX, "");
			const rule = blurRule(value);
			if (rule !== null) {
				const blur = rule as WebRule;
				if (!imageRules.has(blur.id)) {
					registerCss(blur.id, blur.css);
					imageRules.set(blur.id, true);
				}
				el.classList.add(blur.id);
			}
			return true;
		}
		if (name === "accessibilityLabel") { el.setAttribute("alt", value); }
		return false;
	}
	return false;
}

// RN resizeMode repeat: an <img> cannot tile, so the element shows its source as a repeated
// background (one class per source, since setStyle rewrites inline style whole) and pushes its
// own picture out of its box.
const imageRules = new Map<string, boolean>();
const tileSources = new Map<string, string>();

function tileImage(el: Node): void {
	swapClass(el, TILE_PREFIX, "");
	if (el.getAttribute("data-resize") !== "repeat") { return; }
	const attr = el.getAttribute("src");
	if (attr === null || attr === "") { return; }
	const src = attr as string;
	const rule = tileRule(src);
	if (tileSources.has(rule.id)) {
		if (tileSources.get(rule.id) !== src) { throw new Error(`Image resizeMode repeat: "${src}" and "${tileSources.get(rule.id)}" hash to the class ${rule.id}`); }
	} else {
		tileSources.set(rule.id, src);
		registerCss(rule.id, rule.css);
	}
	el.classList.add(rule.id);
}

// RN Text's numberOfLines clamps with an ellipsis. Inline style belongs to
// setStyle, which rewrites it whole, so these props travel as classes.
let textRule = false;
const lineRules = new Map<string, boolean>();

function swapClass(el: Node, prefix: string, next: string): void {
	const names: string[] = el.className.split(" ");
	for (const n of names) {
		if (n.startsWith(prefix)) { el.classList.remove(n); }
	}
	if (next !== "") { el.classList.add(next); }
}

function writeTextAttr(el: Node, name: string, value: string): boolean {
	if (name !== "numberOfLines" && name !== "ellipsizeMode" && name !== "selectable") { return false; }
	if (!textRule) {
		registerCss(TEXT_RULES_ID, TEXT_CSS);
		textRule = true;
	}
	if (name === "numberOfLines") {
		const clamped = clampedLines(value);
		if (clamped && !lineRules.has(value)) {
			const rule = linesRule(value);
			registerCss(rule.id, rule.css);
			lineRules.set(value, true);
		}
		swapClass(el, LINES_CLASS, "");
		if (clamped) {
			el.classList.add(LINES_CLASS);
			el.classList.add(linesClass(value));
		}
		return true;
	}
	if (name === "ellipsizeMode") {
		swapClass(el, "neon-clip", value === "clip" ? "neon-clip" : "");
		return true;
	}
	swapClass(el, "neon-select-", value === "false" ? "neon-select-none" : value === "true" ? "neon-select-text" : "");
	return true;
}

// <Svg>: the display list becomes the <svg> element's own markup (src/platform/browser/svg.jms).
