import { HostNode } from "../../render/hostTypes";
import { svgMarkup } from "../../components/svg/markup";
import { installSvgWriter } from "./domCapabilities";

extern class Node {
	innerHTML: string;
	extern getAttribute(name: string): string | null;
	extern setAttribute(name: string, value: string): void;
	extern removeAttribute(name: string): void;
}

function writeSvgList(node: HostNode, list: string): void {
	const el = node as unknown as Node;
	const prefix = el.getAttribute("data-neon-svg") ?? "neon-svg";
	const m = svgMarkup(list, prefix);
	if (m.viewBox === "") { el.removeAttribute("viewBox"); } else { el.setAttribute("viewBox", m.viewBox); }
	if (m.preserveAspectRatio === "") { el.removeAttribute("preserveAspectRatio"); } else { el.setAttribute("preserveAspectRatio", m.preserveAspectRatio); }
	el.innerHTML = m.body;
}

installSvgWriter(writeSvgList);
