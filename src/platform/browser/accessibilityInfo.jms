import {
	AccessibilityFlag, AccessibilityServices, installAccessibilityServices, reduceMotionEvent,
} from "../../api/accessibilityServices";
import { appServices } from "../../api/services";

extern class MotionEvent {}

extern class BrowserMediaQuery {
	matches: boolean;
	extern addEventListener(name: string, handler: (e: MotionEvent) => void): void;
}

extern class window {
	static extern matchMedia(query: string): BrowserMediaQuery;
}

extern function hasWindow(unused: int32): boolean from "(#, typeof window !== 'undefined' && typeof window.matchMedia === 'function')";

const REDUCED_MOTION = "(prefers-reduced-motion: reduce)";

const browserAccessibilityServices: AccessibilityServices = {
	screenReaderEnabled: async (): Promise<boolean> => { return false; },
	reduceMotionEnabled: async (): Promise<boolean> => { return window.matchMedia(REDUCED_MOTION).matches; },
	flag: async (name: AccessibilityFlag): Promise<boolean> => { return false; },
	recommendedTimeoutMillis: async (original: int32): Promise<int32> => { return original; },
	announceWithQueue: (text: string, queue: boolean): void => {
		appServices("AccessibilityInfo.announceForAccessibilityWithOptions").announce(text);
	},
};

installAccessibilityServices(browserAccessibilityServices);

if (hasWindow(0)) {
	const motion = window.matchMedia(REDUCED_MOTION);
	reduceMotionEvent(motion.matches);
	motion.addEventListener("change", (e: MotionEvent): void => { reduceMotionEvent(motion.matches); });
}
