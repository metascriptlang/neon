import { LinkingServices, installLinkingServices } from "../../api/linkingServices";

extern class window {
	static extern open(url: string, target: string, features: string): void;
}

extern class location {
	static href: string;
}

const browserLinkingServices: LinkingServices = {
	openURL: async (url: string): Promise<boolean> => {
		window.open(url, "_blank", "noopener");
		return true;
	},
	canOpenURL: async (url: string): Promise<boolean> => { return true; },
	initialURL: async (): Promise<string> => { return location.href; },
	openSettings: async (): Promise<boolean> => { return false; },
};

installLinkingServices(browserLinkingServices);
