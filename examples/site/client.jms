import { HostNode } from "../../src/render/hostTypes";
import { hydrate } from "../../src/render/hydrate";
import { domHost } from "../../src/platform/browser/dom";
import { createBrowserRoutingHistory, followLinks, followPreloads, followSubmits } from "../../src/platform/browser/routingHistory";
import { RouterProvider, createRouter } from "../../src/navigation/router";
import { FormData, submitForm } from "../../src/navigation/index";
import { routes } from "./site";

extern class Element {}
extern function siteContainer(id: cstring): Element from "document.getElementById(#)";
extern function hydrated(count: int32): void from "(globalThis.neonSiteHydrated = #)";

const opened = createRouter(routes, createBrowserRoutingHistory());
if (opened.ok) {
	const router = opened.value;
	hydrate(<RouterProvider router={router} />, domHost(), siteContainer("app") as unknown as HostNode);
	followLinks((url: string): boolean => router.navigate(url));
	followPreloads((url: string): void => router.preload(url));
	followSubmits((url: string, data: FormData): boolean => submitForm(router, url, data));
	hydrated(1);
}
